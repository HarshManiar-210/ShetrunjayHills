{
  "name": "shetrunjay-hills",
  "version": "0.0.0",
  "private": true,
  "description": "Shetrunjay Hills Web GIS Dashboard — monorepo root",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
